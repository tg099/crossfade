# Public host name (DNS must point to this server; Caddy fetches the certificate)
CROSSFADE_DOMAIN=crossfade.example.com

# Encrypts stored service logins. Generate once, keep safe, never change:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CROSSFADE_SECRET_KEY=

# Optional: app credentials (can also be entered by the admin in the UI)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional tuning
# CROSSFADE_WORKER_THREADS=3
# CROSSFADE_SESSION_DAYS=30
# CROSSFADE_SCHEDULER=1
# Addresses of your reverse proxy, whose X-Forwarded-For/-Proto headers are trusted
# (default: private networks; narrow it down if clients in your LAN reach port 8765 directly)
# FORWARDED_ALLOW_IPS=172.16.0.0/12
# Running a modified version? Link your fork as the "Source code" (AGPL):
# CROSSFADE_SOURCE_URL=https://github.com/you/crossfade
